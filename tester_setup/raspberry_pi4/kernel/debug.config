# WiFi driver debug flags - merged into bcm2711_defconfig via `make kernel`
# Applied by: scripts/config --enable per flag, then old defconfig

# ath family
CONFIG_ATH_DEBUG=y
CONFIG_ATH9K_DEBUGFS=y
CONFIG_ATH9K_HTC_DEBUGFS=y

# rtl8192cu has a known EAPOL delivery bug (MAC ACKs frames but never delivers to wpa_supplicant)
# rtl8xxxu (mainline, CONFIG_RTL8XXXU) replaces it and is already enabled via bcm2711_defconfig
CONFIG_RTL8192CU=n

# rtw88 (in-kernel; shadowed by DKMS when driver-dkms is active)
CONFIG_RTW88_DEBUG=y
CONFIG_RTW88_DEBUGFS=y

# rtw89 (in-kernel; shadowed by DKMS when driver-dkms is active)
CONFIG_RTW89_DEBUGFS=y
CONFIG_RTW89_8852AU=y

# mt76 (in-kernel; out-of-tree build causes symbol version conflicts with in-kernel mt76 stack)
CONFIG_MT76_DEBUG=y

# WiFi stack
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_MAC80211_DEBUG_MENU=y
CONFIG_MAC80211_DEBUG_COUNTERS=y
CONFIG_NL80211_TESTMODE=y

# ath9k/ath9k_htc static tracepoints (the only WiFi driver with dedicated ftrace events)
# mac80211 and cfg80211 tracepoints are always compiled in - no flag needed
# rtw88/rtw89 have no static tracepoints; trace their internals via kprobe events below
CONFIG_ATH_TRACEPOINTS=y

# kprobe events: lets trace-cmd place dynamic probes on any kernel function at runtime
# needed to trace rtw88/rtw89 internal functions (rtw88_tx, rtw89_core_rx, etc.)
CONFIG_KPROBE_EVENTS=y

# trim: not needed for headless WiFi testing
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_DRM=n
CONFIG_DRM_VC4=n
CONFIG_FB=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_BLUETOOTH=n
CONFIG_BT=n
CONFIG_HID_GENERIC=n
CONFIG_USB_HID=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n
CONFIG_USB_GADGET=n
CONFIG_STAGING=n
CONFIG_RC_CORE=n
CONFIG_MEDIA_RC_SUPPORT=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_CIFS=n
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_LEDS_TRIGGER_HEARTBEAT=n
CONFIG_LEDS_TRIGGER_TIMER=n
CONFIG_LEDS_TRIGGER_ONESHOT=n

CONFIG_WLAN_VENDOR_INTEL=n     # iwlwifi
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_MICROCHIP=n