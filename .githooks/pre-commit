#!/usr/bin/env bash
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM -- \
  '*.c' '*.h' '*.cc' '*.cpp' '*.cxx' '*.hpp' '*.hxx' '*.hh' '*.inl' '*.cmake')
unstaged=$(git diff --name-only --diff-filter=M -- \
  '*.c' '*.h' '*.cc' '*.cpp' '*.cxx' '*.hpp' '*.hxx' '*.hh' '*.inl' '*.cmake')
files=$(printf '%s\n%s' "$staged" "$unstaged" | sort -u | grep -v '^$' || true)

[ -z "$files" ] && exit 0

bad=$(echo "$files" | xargs -d'\n' grep -InP --color=always \
  '[^\x00-\x7F]|^[ \t]*[\r\v\f][ \t\r\v\f]*$|[ \t]+$' 2>/dev/null || true)

[ -z "$bad" ] && exit 0

echo "$bad"

if [ "${FIX:-1}" != "1" ]; then
  echo ""
  echo "  fix trailing whitespace / blank control-chars: FIX=1 git commit ..."
  echo "  non-ASCII must be fixed manually"
  exit 1
fi

# ponytail: re-stages whole file; unstaged hunks in same file get included
echo "$files" | xargs -d'\n' perl -i -pe '
  s/[ \t]+$//;          # trailing whitespace
  s/^[ \t\r\v\f]+$//;   # blank lines with control chars
  s/\xc2\xa7/Sec./g;    # § -> Sec.
  s/\xe2\x80\x94/-/g;   # em dash -> -
  s/\xe2\x86\x92/->/g;  # → ->
  s/\xc3\x97/x/g;       # × -> x
'
# only restage what was already staged
[ -n "$staged" ] && echo "$staged" | xargs -d'\n' git add

remaining=$(echo "$files" | xargs -d'\n' grep -InP \
  '[^\x00-\x7F]|^[ \t]*[\r\v\f][ \t\r\v\f]*$|[ \t]+$' 2>/dev/null || true)

if [ -n "$remaining" ]; then
  echo "auto-fixed whitespace; non-ASCII still present (fix manually):"
  echo "$remaining"
  exit 1
fi

echo "auto-fixed and re-staged"
exit 0
